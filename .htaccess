<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent rewrite loop if request is already inside public/
    RewriteRule ^public/ - [L]

    # Serve real files (css, js, images, etc.) directly from root
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Everything else (pages, routes, root /) → CI4 front controller
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
